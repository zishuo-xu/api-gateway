#!/usr/bin/env bash
# mihomo 出口通道自愈守卫
#
# 它治什么
# --------
# 机场节点会换 IP。mihomo 把「节点域名 -> 真实 IP」的解析结果持久化在
# /opt/mihomo/cache.db 里，而这个缓存不会因为 IP 失效而自动作废——
# 于是 mihomo 会一直拿旧 IP 去连，表现为网关侧 401 / upstream_error，
# 上游体是 {"error":{"message":"fetch failed","type":"auth_error"}}。
#
# 2026-08-31 实际发生过一次：机场某个节点的 IP 换了新的，mihomo 抱着
# 22 小时前的旧地址，通道整整断了一晚上。
# 具体地址不写进公开仓库，排查时从 mihomo 日志里取当次的即可。
#
# 为什么这样探测
# --------------
# 不用 Grok 真实请求：一天 144 次 × 约 640 prompt tokens ≈ 9 万 tokens/天，
# 白白吃掉订阅额度，而且出口挂和 OAuth 过期都表现为"失败"，分不清该修谁。
#
# 用全组 delay 测试而不是单节点：试过 /proxies/{name}/delay，三种 URL 编码
# 方式（quote / quote_plus / 不编码）全部返回 Resource not found，
# 连 /proxies/{name} 查节点信息都找不到——mihomo 处理不了这种带 emoji 和
# 竖线的节点名。而 /group/PROXY/delay 是好的。
#
# 全组测试还有个额外好处：它本身就带治疗作用。mihomo 测完会自动切到
# 最快的节点，相当于顺手替我们做了一次修复，不用干等 5 分钟的 url-test。
#
# 用法
# ----
#   ./gw-proxy-guard            # 由 cron 每 10 分钟调用
#   ./gw-proxy-guard --verbose  # 手动跑，看过程
#
set -u

LOG=/var/log/gw-proxy-guard.log
STATE=/var/lib/gw-proxy-guard
MIHOMO_API=http://127.0.0.1:9090
CACHE_DB=/opt/mihomo/cache.db
FAIL_FILE=$STATE/exit_fail_count
LAST_FIX=$STATE/last_fix

COOLDOWN_SEC=1800   # 两次恢复动作之间至少隔 30 分钟
FAIL_THRESHOLD=2    # 连续失败 2 次（=20 分钟）才动手，避开瞬时抖动
URLTEST_WAIT=60     # 重启后 mihomo 要重跑 url-test，期间测什么都是失败的

VERBOSE=0
[ "${1:-}" = "--verbose" ] && VERBOSE=1

log() {
    echo "$(date '+%F %T') $*" >>"$LOG"
    [ "$VERBOSE" = 1 ] && echo "$*"
}

mkdir -p "$STATE"

# 当前 url-test 选中的节点，仅用于记日志。
current_node() {
    curl -s -m 5 "$MIHOMO_API/proxies/PROXY" 2>/dev/null |
        python3 -c 'import sys,json
try:
    print(json.load(sys.stdin).get("now","?"))
except Exception:
    print("?")' 2>/dev/null
}

# 全组延迟测试，输出 "可用数 总数"。
# 用 python 解析而不是 grep——节点名本身带数字（如"日本东京01"），grep 会误判。
probe() {
    local raw
    raw=$(curl -s -m 60 "$MIHOMO_API/group/PROXY/delay?url=https://api.x.ai&timeout=8000" 2>/dev/null)
    [ -z "$raw" ] && { echo "0 0"; return; }
    printf '%s' "$raw" | python3 -c 'import sys,json
try:
    d = json.load(sys.stdin)
except Exception:
    print("0 0"); sys.exit()
alive = sum(1 for v in d.values() if isinstance(v, (int, float)))
print(f"{alive} {len(d)}")' 2>/dev/null
}

# ---------------------------------------------------------------- 主流程
node=$(current_node)
read -r alive total <<<"$(probe)"

if [ "${alive:-0}" -gt 0 ]; then
    echo 0 >"$FAIL_FILE"
    log "出口正常（可用 ${alive}/${total}，当前: $node）"
    exit 0
fi

n=$(cat "$FAIL_FILE" 2>/dev/null || echo 0)
n=$((n + 1))
echo "$n" >"$FAIL_FILE"
log "出口不通（可用 ${alive:-0}/${total:-0}，当前: $node，连续 $n/$FAIL_THRESHOLD）"

if [ "$n" -lt "$FAIL_THRESHOLD" ]; then
    log "未达阈值，下次再确认"
    exit 0
fi

# 全组无一可用，按 DNS 缓存失效处理
now=$(date +%s)
last=$(cat "$LAST_FIX" 2>/dev/null || echo 0)
if [ $((now - last)) -lt "$COOLDOWN_SEC" ]; then
    log "距上次恢复仅 $((now - last))s (<${COOLDOWN_SEC}s)，跳过——避免在恢复过程中反复重启"
    exit 0
fi

log "全组无可用节点，按 DNS 缓存失效处理：删除缓存并重启 mihomo"
# 必须删了这个再重启。单独 restart 是无效的：cache.db 在启动时被原样读回，
# 等于换一个进程去读同一份过期数据。
rm -f "$CACHE_DB"
docker restart mihomo >/dev/null 2>&1
echo "$now" >"$LAST_FIX"

# 刚重启的 mihomo 还没跑完 url-test，这时候探测必然失败，
# 会把"正在自愈"误判成"恢复无效"，进而触发下一轮重启。
log "等待 ${URLTEST_WAIT}s 让 mihomo 完成 url-test"
sleep "$URLTEST_WAIT"

node=$(current_node)
read -r alive total <<<"$(probe)"
if [ "${alive:-0}" -gt 0 ]; then
    log "已自愈：出口恢复（可用 ${alive}/${total}，当前: $node）"
    echo 0 >"$FAIL_FILE"
else
    log "恢复失败：清缓存重启后仍不通，需人工介入（多半是机场侧整体故障，不是 IP 漂移）"
fi
