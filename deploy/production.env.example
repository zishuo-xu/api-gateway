# 生产环境变量模板
#
# 使用方式（在服务器上执行，不要把生成的文件提交进版本库）：
#   cp deploy/production.env.example deploy/production.env
#   chmod 600 deploy/production.env
#   vim deploy/production.env
#
# 真实值只存在于服务器上，deploy/production.env 已被 .gitignore 排除。

# PostgreSQL 密码，需与 docker-compose.prod.yml 中的 PG_DSN 保持一致
PG_PASSWORD=

# 管理后台访问令牌
ADMIN_TOKEN=

# 演示用 API Key
DEMO_API_KEY=
