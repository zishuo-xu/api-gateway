REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
PG_DSN=postgres://gateway:gateway@postgres:5432/gateway?sslmode=disable
GATEWAY_ADDR=:8080
DEMO_API_KEY=test-key-123
ADMIN_TOKEN=admin-secret-change-me

# 单次上游请求的超时（秒），包含把流式响应读完整条流的时间。
# LLM 生成动辄几十秒，设置过短会把长回答截断成 502。
UPSTREAM_TIMEOUT_SEC=180

# 一条请求最多尝试多少条渠道（1 = 关闭故障转移）。
MAX_ATTEMPTS=3

# 是否信任 X-Forwarded-For / X-Real-IP 作为客户端 IP。
# 默认 false：直接暴露在公网时信任它们，等于任何人伪造该头就能绕过 IP 白名单。
# 只有在前置了可信反向代理（且代理会覆盖该头）时才打开。
TRUST_PROXY=false

# 是否给流式 chat 请求自动注入 stream_options.include_usage。
# 关闭后供应商不会发用量事件，每次流式调用只能按 1 计，token 统计会失真。
INJECT_STREAM_USAGE=true

# Redis 配额计数器回写 Postgres 的间隔（秒）。
# 调大省写库、调小让控制台数字更实时；进程退出时会强制 flush 一次。
QUOTA_FLUSH_SEC=10

# 启动时自动执行 migrate.sql（幂等，可重复执行）。
# 已有库升级靠它；关掉则需要手工执行 SQL。
AUTO_MIGRATE=true

# OpenAI 兼容的统一入口前缀。客户端把 base_url 指向它，网关按请求体里的
# model 自动选择上游；换供应商只需改 model 名字，地址不变。
# 该前缀是「虚拟版本号」，转发前会被剥掉，不会拼到上游 URL 里。
# 设置为 off 可关闭，只保留每条路由自己的专属前缀。
UNIFIED_PREFIX=/v1

# 多副本部署时，各实例多久检查一次「别人改了路由没」。
# 路由表在进程内存里，管理操作只会在收到请求的那个实例上重载；
# 靠 Redis 里的一个版本号把变更广播给其他实例。0 = 关闭（单实例）。
# 另有每 5 分钟一次的全量兜底重载，覆盖 Redis 计数器丢失或手工改库的情况。
ROUTE_RELOAD_SEC=10

# 单 IP 限流上限（RPS）。0 = 关闭该维度。
# 开启前确认流量不是全走同一个 NAT / 出口网关，否则所有人会被算成一个来源。
IP_RPS=0
